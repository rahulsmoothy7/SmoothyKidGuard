<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLockView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- Normal PIN Authentication View -->
    <LinearLayout
        android:id="@+id/layoutPinContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ivLockShield"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/brand_primary"
            android:padding="16dp"
            android:background="@drawable/bg_pin_button" />

        <TextView
            android:id="@+id/tvLockedAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_is_locked"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_dark" />

        <TextView
            android:id="@+id/tvPinSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/enter_parent_pin"
            android:textSize="14sp"
            android:textColor="@color/text_secondary_dark" />

        <!-- PIN Dots Indicator -->
        <LinearLayout
            android:id="@+id/layoutPinDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_button" />
            <View
                android:id="@+id/dot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_button" />
            <View
                android:id="@+id/dot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_button" />
            <View
                android:id="@+id/dot4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_pin_button" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 3x4 Number Keypad -->
        <TableLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TableRow android:gravity="center">
                <TextView android:id="@+id/btn1" style="@style/PinKeyStyle" android:text="1" />
                <TextView android:id="@+id/btn2" style="@style/PinKeyStyle" android:text="2" />
                <TextView android:id="@+id/btn3" style="@style/PinKeyStyle" android:text="3" />
            </TableRow>
            <TableRow android:gravity="center">
                <TextView android:id="@+id/btn4" style="@style/PinKeyStyle" android:text="4" />
                <TextView android:id="@+id/btn5" style="@style/PinKeyStyle" android:text="5" />
                <TextView android:id="@+id/btn6" style="@style/PinKeyStyle" android:text="6" />
            </TableRow>
            <TableRow android:gravity="center">
                <TextView android:id="@+id/btn7" style="@style/PinKeyStyle" android:text="7" />
                <TextView android:id="@+id/btn8" style="@style/PinKeyStyle" android:text="8" />
                <TextView android:id="@+id/btn9" style="@style/PinKeyStyle" android:text="9" />
            </TableRow>
            <TableRow android:gravity="center">
                <ImageView android:id="@+id/btnBiometric" style="@style/PinKeyIconStyle" android:src="@drawable/ic_shield" android:contentDescription="Biometric" />
                <TextView android:id="@+id/btn0" style="@style/PinKeyStyle" android:text="0" />
                <ImageView android:id="@+id/btnBackspace" style="@style/PinKeyIconStyle" android:src="@drawable/ic_unlock" android:contentDescription="Backspace" />
            </TableRow>
        </TableLayout>

    </LinearLayout>

    <!-- Disguise / Fake Crash View (Optional Kid Protection Mode) -->
    <LinearLayout
        android:id="@+id/layoutFakeCrash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Notice"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fake_crash_msg"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitFakeCrash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/close_app"
            android:backgroundTint="@color/brand_primary"
            app:cornerRadius="10dp" />
    </LinearLayout>

</RelativeLayout>
