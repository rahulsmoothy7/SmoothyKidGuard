<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_dark"
                android:layout_marginBottom="20dp" />

            <!-- Section 1: Display & Theme -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_setting_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border_dark"
                app:cardBackgroundColor="@color/surface_dark"
                android:layout_marginBottom="24dp">

                <RadioGroup
                    android:id="@+id/rgThemeMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <RadioButton
                        android:id="@+id/rbThemeDark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_dark"
                        android:textColor="@color/text_primary_dark"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbThemeAmoled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_amoled"
                        android:textColor="@color/text_primary_dark" />

                    <RadioButton
                        android:id="@+id/rbThemeLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_light"
                        android:textColor="@color/text_primary_dark" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Accent Color Customization -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_accent_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border_dark"
                app:cardBackgroundColor="@color/surface_dark"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/layoutColorPalette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="16dp">

                    <View
                        android:id="@+id/colorIndigo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_button"
                        android:backgroundTint="@color/accent_indigo" />

                    <View
                        android:id="@+id/colorEmerald"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_button"
                        android:backgroundTint="@color/accent_emerald" />

                    <View
                        android:id="@+id/colorOcean"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_button"
                        android:backgroundTint="@color/accent_ocean" />

                    <View
                        android:id="@+id/colorPurple"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_button"
                        android:backgroundTint="@color/accent_purple" />

                    <View
                        android:id="@+id/colorCoral"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_pin_button"
                        android:backgroundTint="@color/accent_coral" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Typography & Font -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/font_style_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border_dark"
                app:cardBackgroundColor="@color/surface_dark"
                android:layout_marginBottom="24dp">

                <RadioGroup
                    android:id="@+id/rgFontStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <RadioButton
                        android:id="@+id/rbFontModern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/font_modern"
                        android:textColor="@color/text_primary_dark"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbFontRounded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/font_rounded"
                        android:textColor="@color/text_primary_dark" />

                    <RadioButton
                        android:id="@+id/rbFontSerif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/font_serif"
                        android:textColor="@color/text_primary_dark" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Security & Kid Protection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/security_settings_title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border_dark"
                app:cardBackgroundColor="@color/surface_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Biometric Switch -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_biometrics"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="15sp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchBiometrics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:checked="true" />
                    </RelativeLayout>

                    <!-- Fake Crash Switch -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toStartOf="@+id/switchFakeCrash"
                            android:layout_alignParentStart="true"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/enable_fake_crash"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fake_crash_desc"
                                android:textColor="@color/text_secondary_dark"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchFakeCrash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <!-- Change PIN Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/change_pin"
                        android:textColor="@color/text_primary_dark"
                        app:strokeColor="@color/card_border_dark"
                        app:strokeWidth="1dp"
                        android:backgroundTint="@color/surface_dark"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
