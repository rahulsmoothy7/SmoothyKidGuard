<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_tagline"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_dark" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="9dp"
                    android:background="@drawable/bg_pin_button"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_primary_dark"
                    android:contentDescription="Settings" />
            </RelativeLayout>

            <!-- Permission Warning Card (Hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#2D1B1B"
                app:strokeColor="#7F1D1D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_required_title"
                        android:textColor="#FCA5A5"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPermissionDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/permission_usage_desc"
                        android:textColor="#FECACA"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/grant_permission"
                        app:cornerRadius="8dp"
                        android:backgroundTint="#DC2626"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Master Kid Guard Toggle Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKidMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border_dark"
                app:cardBackgroundColor="@color/surface_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivShieldIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/accent_emerald"
                            android:padding="8dp"
                            android:background="@drawable/bg_pin_button" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivShieldIcon"
                            android:layout_marginStart="14dp"
                            android:layout_centerVertical="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/kid_mode_title"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary_dark" />

                            <TextView
                                android:id="@+id/tvKidModeStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/kid_mode_subtitle_active"
                                android:textSize="13sp"
                                android:textColor="@color/accent_emerald" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchKidMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true"
                            app:useMaterialThemeColors="true" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/card_border_dark" />

                    <TextView
                        android:id="@+id/tvProtectedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 Apps Protected"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Filter Bar -->
            <EditText
                android:id="@+id/etSearchApp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="16dp"
                android:hint="@string/search_apps_hint"
                android:textColorHint="@color/text_secondary_dark"
                android:textColor="@color/text_primary_dark"
                android:textSize="14sp"
                android:drawableStart="@drawable/ic_shield"
                android:drawablePadding="10dp"
                android:drawableTint="@color/text_secondary_dark" />

            <!-- App List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAppsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:indeterminateTint="@color/brand_primary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
